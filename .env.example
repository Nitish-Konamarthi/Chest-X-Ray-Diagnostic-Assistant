# ============================================================
# Chest X-Ray Diagnostic Assistant — Environment Variables
# ============================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# NEVER commit .env to version control!
# ============================================================

# Required: Google Gemini API key for AI clinical explanations
# Get yours free: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Required: Geoapify API key for nearby doctor search
# Get yours free: https://www.geoapify.com/
GEOAPIFY_API_KEY=

# Optional: HuggingFace token (only needed for private model repos)
# The default public repo (NitishKvv/chexnet-models) does NOT require this.
# HF_TOKEN=

# Optional: Custom model repo on HuggingFace Hub
# Default: NitishKvv/chexnet-models
# HF_REPO_ID=NitishKvv/chexnet-models

# Optional: Comma-separated CORS origins (for deploying behind a custom domain)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
